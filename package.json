{
  "name": "gutsignal",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:watch": "jest --watch",
    "doctor": "npx expo-doctor",
    "verify": "npm run verify:fast",
    "verify:fast": "npm run typecheck && npm run lint && npm test",
    "verify:full": "npm run format:check && npm run typecheck && npm run lint && npm run test:ci && npm run doctor && npm run export:ios",
    "export:ios": "expo export --platform ios",
    "report:sample": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sample-report.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.114.0",
    "@tanstack/react-query": "^5.102.2",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "coverageThreshold": {
      "src/domain/pattern-engine/": {
        "statements": 95,
        "branches": 88,
        "functions": 95,
        "lines": 97
      },
      "src/domain/patterns/": {
        "statements": 95,
        "branches": 87,
        "functions": 98,
        "lines": 98
      },
      "src/services/sync/": {
        "statements": 88,
        "branches": 80,
        "functions": 77,
        "lines": 88
      },
      "src/services/db/": {
        "statements": 74,
        "branches": 38,
        "functions": 84,
        "lines": 73
      },
      "src/services/auth/": {
        "statements": 28,
        "branches": 55,
        "functions": 12,
        "lines": 26
      },
      "src/features/account/": {
        "statements": 55,
        "branches": 35,
        "functions": 35,
        "lines": 55
      }
    }
  }
}

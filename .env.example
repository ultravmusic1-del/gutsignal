# GutSignal environment variables — NAMES ONLY, never real values.
# Anything prefixed EXPO_PUBLIC_ is embedded in the app binary and is PUBLIC.
# Server secrets belong in Supabase Edge Function secrets, never here.

# --- Public client configuration (safe to ship in the app) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=

# --- Server-only (Supabase Edge Function secrets) ---
# Documented here for reference only. Do NOT set these in this file.
#   AI_PROVIDER_API_KEY
#   REVENUECAT_WEBHOOK_SECRET
#   SUPABASE_SERVICE_ROLE_KEY
